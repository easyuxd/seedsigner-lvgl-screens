{
  "_about": "Redesign design tokens: the CSS of the LVGL Redesign. Sizes are points on a 320pt-wide canvas; the engine multiplies them by (screen width / base_width). Colors never scale. Rules for every token: context/design-system.md. Keys starting with _ are notes and are ignored.",

  "base_width": 320,

  "color": {
    "bg": "#000000",
    "surface": "#2C2C2C",
    "surface2": "#242424",
    "inactive": "#414141",
    "surfacePress": "#3A3A3A",
    "activePress": "#D97F00",
    "fg1": "#FCFCFC",
    "fg2": "#B0B0B0",
    "fg3": "#777777",
    "active": "#FF9F0A",
    "success": "#30D158",
    "warning": "#FFD60A",
    "dire": "#FF5700",
    "error": "#FF1B0A",
    "info": "#409CFF"
  },

  "type": {
    "_note": "size and lh (line height) in points. Weight 400 = Open Sans Regular, 600 = Open Sans SemiBold.",
    "display": { "size": 32, "lh": 34 },
    "hero":    { "size": 26, "lh": 30 },
    "title":   { "size": 22, "lh": 26 },
    "large":   { "size": 20, "lh": 26 },
    "button":  { "size": 18, "lh": 22 },
    "body":    { "size": 17, "lh": 22 },
    "small":   { "size": 16, "lh": 20 },
    "caption": { "size": 15, "lh": 20 },
    "micro":   { "size": 13, "lh": 16 }
  },

  "space":  { "xxs": 4, "xs": 8, "sm": 12, "md": 16, "lg": 24, "xl": 32, "xxl": 48 },

  "radius": { "sm": 8, "md": 12, "lg": 16, "pill": 999 },

  "metric": {
    "edge": 16,
    "navH": 72,
    "rowH": 48,
    "tileH": 84,
    "tap": 44,
    "navInset": 12,
    "bodyGap": 10,
    "listGap": 8,
    "sectionH": 28,
    "navTitleMax": 208,
    "bodyBottom": 14,
    "optionH": 60,
    "optionPadX": 14,
    "switchW": 46,
    "switchH": 28,
    "dashedBorder": 1.5,
    "snackH": 64,
    "snackSubH": 80
  },

  "icon": {
    "nav": 26,
    "navPower": 24,
    "row": 24,
    "seed": 26,
    "seedHeader": 34,
    "tile": 40,
    "chevron": 18,
    "sectionChevron": 16,
    "add": 22,
    "check": 22,
    "snack": 26
  },

  "motion": {
    "_note": "Durations in milliseconds. Easing names map to LVGL anim paths: out, in_out, linear.",
    "press":     { "ms": 160, "scale": 0.96, "ease": "out" },
    "snackIn":   { "ms": 200, "ease": "out" },
    "snackOut":  { "ms": 150, "ease": "in_out" },
    "snackHold": { "ms": 2600 }
  },

  "opacity": {
    "muted": 0.38
  }
}
