{
  "_about": "Redesign clickable prototype: every screen, built from components, and where each tap goes. Ported from seedsigner-touchscreen/prototype/screens.jsx. Schema and rules: context/architecture.md. Keys starting with _ are notes.",

  "start": "home",

  "state": {
    "kb_style": "Default",
    "persistent": true,
    "signer": "73c5da0a",
    "sign_next": "psbt_signing",
    "seed_fp": "73c5da0a",
    "seed_sub": "Single sig · Native segwit",
    "seed_signs": "psbt_signing",
    "new_fp": "5f1e0c3a",
    "backup_next": "home/seed",
    "passphrase": "",
    "bip85_index": "",
    "word_no": 1,
    "word_total": 12,
    "dice_need": 50,
    "coordinator": "Sparrow",
    "derivation": "m/84'/0'/0'"
  },

  "_flows": "Design Studio only: groups the screens into sections on the canvas, in this order. The device ignores it. A screen in no flow shows under Ungrouped.",
  "flows": [
    { "id": "home", "title": "Home and seeds", "description": "Where every session starts: the seed list, one seed, adding a seed.",
      "screens": ["home", "seeds", "seed", "add_seed"] },
    { "id": "tools", "title": "Tools and settings", "description": "Everything off Home that isn’t a seed.",
      "screens": ["tools", "settings", "kb_style"] },
    { "id": "psbt_review", "title": "Sign PSBT · review", "description": "Pick the signer, then how much leaves this wallet and where it goes.",
      "screens": ["psbt_select_seed", "psbt_overview", "psbt_math", "psbt_send_1", "psbt_send_2", "psbt_change"] },
    { "id": "psbt_sign", "title": "Sign PSBT · sign", "description": "The one irreversible control on the device: a slide, not a tap.",
      "screens": ["psbt_sign", "psbt_signing", "psbt_signing_fail", "psbt_error"] },
    { "id": "psbt_alerts", "title": "Sign PSBT · warnings", "description": "Three severities, one component: warning, dire and error.",
      "screens": ["psbt_warn_script", "psbt_warn_nochange", "psbt_verify_failed"] },
    { "id": "qr", "title": "QR transport", "description": "The air gap: scanning in (simulated; no camera yet) and an animated QR out.",
      "screens": ["scan_psbt", "scan_signer", "scan_seedqr", "scan_idle", "scan_unrecognized", "psbt_signed_qr"] },
    { "id": "backup", "title": "Seed backup", "description": "Show the words behind a warning, then optionally check three of them.",
      "screens": ["backup", "words_warning", "words_1", "words_2", "words_3", "backup_prompt", "backup_quiz_1", "backup_quiz_2", "backup_quiz_3"] },
    { "id": "discard", "title": "Discard seed", "description": "Wiping a seed from the device, with keeping it as the easy choice.",
      "screens": ["discard"] }
  ],

  "screens": {
    "home": {
      "type": "menu_grid",
      "_note": "Home, 'Scan hero' direction: seeds on top, Scan promoted to the thumb zone at the bottom.",
      "navbar": { "title": "Home", "left": "power" },
      "body": [
        { "type": "group", "children": [
          { "type": "section_head", "label": "Seeds", "right": "All 5", "go": "seeds" },
          { "type": "seed_row", "fp": "73c5da0a", "go": "seed", "set": { "seed_fp": "73c5da0a", "seed_sub": "Single sig · Native segwit", "seed_signs": "psbt_signing" } },
          { "type": "seed_row", "fp": "8a1f0c2b", "go": "seed", "set": { "seed_fp": "8a1f0c2b", "seed_sub": "Single sig · + passphrase", "seed_signs": "psbt_signing_fail" } },
          { "type": "seed_row", "fp": "d5630e9f", "go": "seed", "set": { "seed_fp": "d5630e9f", "seed_sub": "Multisig · 2-of-3", "seed_signs": "psbt_signing_fail" } }
        ]}
      ],
      "actions": [
        { "type": "tile", "icon": "scan", "label": "Scan QR", "primary": true, "h": 80, "go": "scan_psbt",
          "_note": "There's no camera yet: the scanner simulates receiving a PSBT, then opens Select Signer." },
        { "type": "row", "children": [
          { "type": "tile", "icon": "tools", "label": "Tools", "h": 80, "go": "tools" },
          { "type": "tile", "icon": "settings", "label": "Settings", "h": 80, "go": "settings" }
        ]}
      ]
    },

    "seeds": {
      "type": "menu_list",
      "navbar": { "title": "Seeds", "left": "back" },
      "body": [
        { "type": "group", "children": [
          { "type": "seed_row", "fp": "73c5da0a", "sub": "Single sig · Native segwit", "go": "seed",
            "set": { "seed_fp": "73c5da0a", "seed_sub": "Single sig · Native segwit", "seed_signs": "psbt_signing" } },
          { "type": "seed_row", "fp": "8a1f0c2b", "sub": "Single sig · + passphrase", "go": "seed",
            "set": { "seed_fp": "8a1f0c2b", "seed_sub": "Single sig · + passphrase", "seed_signs": "psbt_signing_fail" } },
          { "type": "seed_row", "fp": "d5630e9f", "sub": "Multisig · 2-of-3", "go": "seed",
            "set": { "seed_fp": "d5630e9f", "seed_sub": "Multisig · 2-of-3", "seed_signs": "psbt_signing_fail" } },
          { "type": "seed_row", "fp": "2f9c41ab", "sub": "Single sig · Taproot", "go": "seed",
            "set": { "seed_fp": "2f9c41ab", "seed_sub": "Single sig · Taproot", "seed_signs": "psbt_signing_fail" } },
          { "type": "seed_row", "fp": "0b7e5d63", "sub": "Single sig · Nested segwit", "go": "seed",
            "set": { "seed_fp": "0b7e5d63", "seed_sub": "Single sig · Nested segwit", "seed_signs": "psbt_signing_fail" } }
        ]}
      ],
      "actions": [
        { "type": "add_row", "label": "Load or create seed", "go": "add_seed" }
      ]
    },

    "seed": {
      "type": "menu_list",
      "_note": "Seed detail (object, then its actions). Shows the seed in state seed_fp: a seed row sets it, and so do new seeds.",
      "navbar": { "title": "{seed_fp}", "left": "back" },
      "body": [
        { "type": "seed_header", "fp": "{seed_fp}", "sub": "{seed_sub}" },
        { "type": "group", "children": [
          { "type": "list_item", "icon": "sign", "label": "Sign PSBT", "go": "scan_signer",
            "set": { "signer": "{seed_fp}", "sign_next": "{seed_signs}" } },
          { "type": "list_item", "icon": "derivation", "label": "Export Xpub", "go": "xpub_sigtype" },
          { "type": "list_item", "icon": "check", "label": "Address Explorer", "muted": true },
          { "type": "list_item", "icon": "seeds", "label": "Backup Seed", "go": "backup",
            "set": { "backup_next": "home/seed" } },
          { "type": "list_item", "icon": "passphrase", "label": "Add passphrase", "go": "passphrase",
            "set": { "passphrase": "" } },
          { "type": "list_item", "icon": "derivation", "label": "BIP-85 child seed", "go": "bip85_mode" },
          { "type": "list_item", "icon": "error", "icon_color": "dire", "label": "Discard seed", "chevron": false,
            "go": "discard" }
        ]}
      ]
    },

    "add_seed": {
      "type": "menu_list",
      "navbar": { "title": "Add Seed", "left": "back" },
      "body": [
        { "type": "section_head", "label": "Load an existing seed" },
        { "type": "list_item", "icon": "qrcode", "label": "Scan a SeedQR", "value": "Fastest", "go": "scan_seedqr" },
        { "type": "list_item", "icon": "seeds", "label": "Enter seed words", "go": "enter_words_count" },
        { "type": "list_item", "icon": "microsd", "label": "Restore from microSD", "muted": true },
        { "type": "spacer", "h": 6 },
        { "type": "section_head", "label": "Or start fresh" },
        { "type": "list_item", "icon": "plus", "label": "Create a new seed", "go": "new_seed_count" }
      ]
    },

    "tools": {
      "type": "menu_list",
      "navbar": { "title": "Tools", "left": "back" },
      "body": [
        { "type": "list_item", "icon": "derivation", "label": "Address explorer", "muted": true },
        { "type": "list_item", "icon": "check", "label": "Verify address", "muted": true },
        { "type": "list_item", "icon": "seeds", "label": "Seed word calculator", "muted": true },
        { "type": "list_item", "icon": "bitcoin", "label": "Sats / fiat converter", "muted": true },
        { "type": "list_item", "icon": "qrcode", "label": "Create a SeedQR", "muted": true }
      ]
    },

    "settings": {
      "type": "menu_list",
      "navbar": { "title": "Settings", "left": "back" },
      "body": [
        { "type": "list_item", "icon": "space", "label": "Keyboard", "value": "{kb_style}", "go": "kb_style" },
        { "type": "list_item", "icon": "info", "label": "Language", "value": "English" },
        { "type": "list_item", "icon": "bitcoin", "label": "Network", "value": "Mainnet" },
        { "type": "list_item", "icon": "qrcode", "label": "QR density", "value": "High" },
        { "type": "list_item", "icon": "scan", "label": "Display & camera" },
        { "type": "list_item", "icon": "microsd", "label": "microSD" },
        { "type": "toggle_row", "icon": "restart", "label": "Persistent settings", "state": "persistent" },
        { "type": "list_item", "icon": "info", "label": "About" }
      ]
    },

    "kb_style": {
      "type": "menu_bottom_list",
      "navbar": { "title": "Keyboard", "left": "back" },
      "body": [
        { "type": "choice_list", "choice": "kb_style", "options": [
          { "label": "Default", "blurb": "iOS layout · 27 × 42 px keys" },
          { "label": "Ladder", "blurb": "Five columns · 60 × 34 px keys" },
          { "label": "Halo", "blurb": "iOS layout · hit zones 76% bigger" },
          { "label": "Loupe", "blurb": "Preview, slide, release to type" }
        ]}
      ],
      "actions": [
        { "type": "cta", "label": "Try it", "go": "passphrase", "set": { "passphrase": "" } }
      ]
    },

    "psbt_select_seed": {
      "type": "menu_list",
      "_note": "PSBT flow, demo transaction 'Standard spend' (prototype psbt.jsx PSBT_SCENARIOS[0]). Only 73c5da0a owns the inputs; picking another seed lets you reach Sign Failed, as upstream allows.",
      "navbar": { "title": "Select Signer", "left": "back" },
      "body": [
        { "type": "note", "icon": "sign", "icon_color": "info", "children": [
          { "type": "btc_amount", "sats": 2453100, "style": "caption", "prefix": "Spending", "prefix_color": "fg1",
            "sub": false },
          { "type": "text", "text": "Which key signs it?", "style": "caption", "weight": 400 }
        ]},
        { "type": "group", "children": [
          { "type": "seed_row", "fp": "73c5da0a", "sub": "Signs this transaction", "sub_color": "success",
            "trail": "success", "trail_color": "success", "set": { "signer": "73c5da0a", "sign_next": "psbt_signing" },
            "go": "psbt_overview" },
          { "type": "seed_row", "fp": "8a1f0c2b", "icon_color": "fg2", "fp_color": "fg2",
            "sub": "Not in this transaction",
            "set": { "signer": "8a1f0c2b", "sign_next": "psbt_signing_fail" }, "go": "psbt_overview" },
          { "type": "seed_row", "fp": "d5630e9f", "icon_color": "fg2", "fp_color": "fg2",
            "sub": "Not in this transaction",
            "set": { "signer": "d5630e9f", "sign_next": "psbt_signing_fail" }, "go": "psbt_overview" },
          { "type": "seed_row", "fp": "2f9c41ab", "icon_color": "fg2", "fp_color": "fg2",
            "sub": "Not in this transaction",
            "set": { "signer": "2f9c41ab", "sign_next": "psbt_signing_fail" }, "go": "psbt_overview" },
          { "type": "seed_row", "fp": "0b7e5d63", "icon_color": "fg2", "fp_color": "fg2",
            "sub": "Not in this transaction",
            "set": { "signer": "0b7e5d63", "sign_next": "psbt_signing_fail" }, "go": "psbt_overview" }
        ]}
      ],
      "actions": [
        { "type": "add_row", "label": "Load the signing seed", "go": "add_seed" }
      ]
    },

    "psbt_overview": {
      "type": "review",
      "_note": "The whole transaction at once. Rows name their role; tapping one opens the full address.",
      "navbar": { "title": "Review", "subtitle": "2 inputs · 2 recipients", "left": "back" },
      "body": [
        { "type": "step_rail", "steps": 5, "at": 0 },
        { "type": "group", "children": [
          { "type": "text", "text": "SENDING", "style": "micro", "weight": 700, "color": "fg2", "align": "center", "tracking": 1.6 },
          { "type": "btc_amount", "sats": 2453100, "style": "display", "align": "center" }
        ]},
        { "type": "tx_card", "rows": [
          { "tag": "TO", "label": "Recipient 1", "sats": 2400000, "go": "psbt_send_1" },
          { "tag": "TO", "label": "Recipient 2", "sats": 53100, "go": "psbt_send_2" },
          { "tag": "FEE", "label": "~ 15 sat/vB", "sats": 3100 },
          { "tag": "CHANGE", "label": "Verified", "label_color": "success", "sats": 993800, "go": "psbt_change" }
        ]},
        { "type": "btc_amount", "sats": 3450000, "style": "micro", "color": "fg2", "align": "center", "unit": false,
          "sub": false, "prefix": "from 2 inputs totalling" }
      ],
      "actions": [
        { "type": "cta", "label": "Review details", "kind": "primary", "go": "psbt_math" }
      ]
    },

    "psbt_math": {
      "type": "review",
      "_note": "Proves the numbers close: inputs - recipients - fee = change.",
      "navbar": { "title": "The Math", "left": "back" },
      "body": [
        { "type": "step_rail", "steps": 5, "at": 1 },
        { "type": "math", "lines": [
          { "label": "2 inputs", "sats": 3450000 },
          { "label": "2 recipients", "sats": 2453100, "sign": "−" },
          { "label": "network fee", "sats": 3100, "sign": "−" },
          { "label": "change", "sats": 993800, "rule": true }
        ]}
      ],
      "actions": [
        { "type": "cta", "label": "Review recipients", "kind": "primary", "go": "psbt_send_1" }
      ]
    },

    "psbt_send_1": {
      "type": "review",
      "navbar": { "title": "Will Send", "subtitle": "Recipient 1 of 2", "left": "back" },
      "body": [
        { "type": "step_rail", "steps": 5, "at": 2 },
        { "type": "btc_amount", "sats": 2400000, "style": "hero", "align": "center" },
        { "type": "address_block", "address": "bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4" },
        { "type": "text", "text": "Compare every group against your wallet — not just the first and last.",
          "style": "caption", "weight": 400, "color": "fg2", "align": "center" }
      ],
      "actions": [
        { "type": "cta", "label": "Next recipient", "kind": "primary", "go": "psbt_send_2" }
      ],
      "_note": "The screen a coordinator can lie to you on: amount, then the whole address."
    },

    "psbt_send_2": {
      "type": "review",
      "navbar": { "title": "Will Send", "subtitle": "Recipient 2 of 2", "left": "back" },
      "body": [
        { "type": "step_rail", "steps": 5, "at": 2 },
        { "type": "btc_amount", "sats": 53100, "style": "hero", "align": "center" },
        { "type": "address_block", "address": "bc1q9d4ywgfnd8h43da5tpcxcn6ajv590cg6d3tg6a" },
        { "type": "text", "text": "Compare every group against your wallet — not just the first and last.",
          "style": "caption", "weight": 400, "color": "fg2", "align": "center" }
      ],
      "actions": [
        { "type": "cta", "label": "Next", "kind": "primary", "go": "psbt_change" }
      ]
    },

    "psbt_change": {
      "type": "review",
      "navbar": { "title": "Your Change", "subtitle": "change address #3", "left": "back" },
      "body": [
        { "type": "step_rail", "steps": 5, "at": 3 },
        { "type": "btc_amount", "sats": 993800, "style": "hero", "align": "center" },
        { "type": "address_block", "address": "bc1qar0srrr7xfkvy5l643lydnw9re59gtzzwf5mdq" },
        { "type": "pill", "icon": "success", "label": "Derived from {signer}", "color": "success" }
      ],
      "actions": [
        { "type": "cta", "label": "Next", "kind": "primary", "go": "psbt_sign" }
      ]
    },

    "psbt_sign": {
      "type": "review",
      "_note": "Everything the review established, restated once, above the only irreversible control.",
      "navbar": { "title": "Sign", "left": "back" },
      "body": [
        { "type": "step_rail", "steps": 5, "at": 4 },
        { "type": "summary_card", "rows": [
          { "label": "Sending", "sats": 2453100 },
          { "label": "To", "value": "2 recipients" },
          { "label": "Fee", "sats": 3100 },
          { "label": "Signer", "fp": "{signer}" }
        ]},
        { "type": "text", "text": "Signing is final. The signature leaves this device as a QR code.",
          "style": "caption", "weight": 400, "color": "fg2", "align": "center" }
      ],
      "actions": [
        { "type": "slide_to_confirm", "label": "Slide to sign", "icon": "sign", "go": "{sign_next}" }
      ]
    },

    "psbt_signing": {
      "type": "dialog",
      "navbar": { "title": "Sign" },
      "body": [
        { "type": "spinner", "label": "Adding signature…" }
      ],
      "auto": { "ms": 1600, "go": "psbt_signed_qr" }
    },

    "psbt_signing_fail": {
      "type": "dialog",
      "_note": "Same as psbt_signing, but the chosen seed isn't an input, so signing fails.",
      "navbar": { "title": "Sign" },
      "body": [
        { "type": "spinner", "label": "Adding signature…" }
      ],
      "auto": { "ms": 1600, "go": "psbt_error" }
    },

    "psbt_error": {
      "type": "dialog",
      "navbar": { "title": "Sign Failed" },
      "body": [
        { "type": "message", "kind": "error", "badge": "Signing Failed",
          "body": "Signing with {signer} did not add a valid signature. This key isn't one of the transaction's inputs." }
      ],
      "actions": [
        { "type": "cta", "label": "Select different seed", "kind": "primary", "go": "psbt_select_seed" }
      ]
    },

    "psbt_warn_script": {
      "type": "dialog",
      "_note": "Reached from the 'Unsupported script' demo transaction (not ported); open it from the Screens list.",
      "navbar": { "title": "Caution", "left": "back" },
      "body": [
        { "type": "message", "kind": "warning", "badge": "Unknown script",
          "body": "This transaction has an input script type SeedSigner can't verify. Check the change addresses yourself before signing." }
      ],
      "actions": [
        { "type": "cta", "label": "Continue", "kind": "primary", "go": "psbt_send_1" }
      ]
    },

    "psbt_warn_nochange": {
      "type": "dialog",
      "_note": "Reached from the 'Full spend' demo transaction (not ported); open it from the Screens list.",
      "navbar": { "title": "Caution", "left": "back" },
      "body": [
        { "type": "message", "kind": "warning", "badge": "Full Spend!",
          "body": "This transaction spends its entire input value. No change is coming back to your wallet." }
      ],
      "actions": [
        { "type": "cta", "label": "Continue", "kind": "primary", "go": "psbt_math" }
      ]
    },

    "psbt_verify_failed": {
      "type": "dialog",
      "_note": "Reached from an unverified change address (not in this demo transaction); open it from the Screens list.",
      "navbar": { "title": "Check Change" },
      "body": [
        { "type": "message", "kind": "dire", "badge": "Not your change",
          "body": "The change address could not be derived from {signer}. Change that isn't yours is money you don't get back." }
      ],
      "actions": [
        { "type": "cta", "label": "Discard transaction", "kind": "dire", "go": "home" }
      ]
    },

    "scan_psbt": {
      "type": "input",
      "bleed": true,
      "_note": "QR transport IN (prototype qr.jsx ScanScreen). No camera yet: frames arrive, it says received, then hands off. A tap skips ahead.",
      "body": [
        { "type": "scanner", "label": "transaction", "done": "Transaction received", "total": 24,
          "next": { "go": "psbt_select_seed", "replace": true } }
      ]
    },

    "scan_signer": {
      "type": "input",
      "bleed": true,
      "_note": "Sign PSBT from a seed: the signer is already chosen, so the scan goes straight to Review.",
      "body": [
        { "type": "scanner", "label": "transaction", "done": "Transaction received", "total": 24,
          "next": { "go": "psbt_overview", "replace": true } }
      ]
    },

    "scan_seedqr": {
      "type": "input",
      "bleed": true,
      "body": [
        { "type": "scanner", "label": "SeedQR", "done": "Seed loaded", "total": 1,
          "next": { "go": "finalize", "replace": true, "set": { "new_fp": "e3b0c442" } } }
      ]
    },

    "scan_idle": {
      "type": "input",
      "bleed": true,
      "_note": "Design Studio: the plain viewfinder, pinned. In use it gives up after a few seconds (motion.scanGiveUp) and shows Unrecognized.",
      "body": [
        { "type": "scanner", "phase": "idle" }
      ]
    },

    "scan_unrecognized": {
      "type": "input",
      "bleed": true,
      "_note": "Design Studio: the unrecognized-code state, pinned.",
      "body": [
        { "type": "scanner", "phase": "unrecognized" }
      ]
    },

    "psbt_signed_qr": {
      "type": "review",
      "_note": "QR transport OUT (prototype qr.jsx QRDisplayScreen): the signed PSBT as an animated QR. No back: signing is done, Done leaves.",
      "navbar": { "title": "Signed Transaction", "subtitle": "Scan with your coordinator" },
      "body": [
        { "type": "qr_display", "frames": 12 }
      ],
      "actions": [
        { "type": "qr_controls", "cta": { "label": "Done", "go": "home" } }
      ]
    },

    "backup": {
      "type": "menu_list",
      "navbar": { "title": "Backup Seed", "left": "back" },
      "body": [
        { "type": "list_item", "icon": "seeds", "label": "View seed words", "go": "words_warning" },
        { "type": "list_item", "icon": "qrcode", "label": "Export as SeedQR", "muted": true }
      ]
    },

    "words_warning": {
      "type": "dialog",
      "navbar": { "title": "Caution", "left": "back" },
      "body": [
        { "type": "message", "kind": "dire", "badge": "Classified info",
          "body": "Keep your seed words private & away from every online device." }
      ],
      "actions": [
        { "type": "cta", "label": "I understand", "kind": "primary", "go": "words_1" }
      ]
    },

    "words_1": {
      "type": "review",
      "navbar": { "title": "Seed Words", "subtitle": "1 of 3", "left": "back" },
      "body": [
        { "type": "word_list", "from": 1, "words": ["forum", "undo", "fragile", "fade"] }
      ],
      "actions": [
        { "type": "cta", "label": "Next", "kind": "primary", "go": "words_2" }
      ]
    },

    "words_2": {
      "type": "review",
      "navbar": { "title": "Seed Words", "subtitle": "2 of 3", "left": "back" },
      "body": [
        { "type": "word_list", "from": 5, "words": ["solar", "keen", "mirror", "roof"] }
      ],
      "actions": [
        { "type": "cta", "label": "Next", "kind": "primary", "go": "words_3" }
      ]
    },

    "words_3": {
      "type": "review",
      "navbar": { "title": "Seed Words", "subtitle": "3 of 3", "left": "back" },
      "body": [
        { "type": "word_list", "from": 9, "words": ["talent", "bulk", "apart", "entire"] }
      ],
      "actions": [
        { "type": "cta", "label": "Done", "kind": "primary", "go": "backup_prompt" }
      ]
    },

    "backup_prompt": {
      "type": "dialog",
      "navbar": { "title": "Verify Backup" },
      "body": [
        { "type": "message", "kind": "default", "badge": "Check your backup?",
          "body": "Pick three of your words to make sure you wrote them down right. Optional." }
      ],
      "actions": [
        { "type": "cta", "label": "Verify", "kind": "primary", "go": "backup_quiz_1" },
        { "type": "cta", "label": "Skip", "go": "{backup_next}" }
      ]
    },

    "backup_quiz_1": {
      "type": "review",
      "navbar": { "title": "Verify Word #3", "left": "back" },
      "body": [
        { "type": "step_rail", "steps": 3, "at": 0 },
        { "type": "word_quiz", "answer": "fragile", "choices": ["rocket", "fragile", "harvest", "pilot"],
          "next": { "go": "backup_quiz_2" } }
      ]
    },

    "backup_quiz_2": {
      "type": "review",
      "navbar": { "title": "Verify Word #8", "left": "back" },
      "body": [
        { "type": "step_rail", "steps": 3, "at": 1 },
        { "type": "word_quiz", "answer": "roof", "choices": ["cabin", "silver", "roof", "ocean"],
          "next": { "go": "backup_quiz_3" } }
      ]
    },

    "backup_quiz_3": {
      "type": "review",
      "navbar": { "title": "Verify Word #12", "left": "back" },
      "body": [
        { "type": "step_rail", "steps": 3, "at": 2 },
        { "type": "word_quiz", "answer": "entire", "choices": ["maple", "tiger", "entire", "fossil"],
          "next": { "go": "{backup_next}", "snack": { "type": "success", "label": "Backup verified" } } }
      ]
    },

    "discard": {
      "type": "dialog",
      "_note": "The seed leaves the device. The demo list stays as it is (prototype state beyond toggles is in the backlog).",
      "navbar": { "title": "Discard", "left": "back" },
      "body": [
        { "type": "message", "kind": "warning", "badge": "Discard seed?",
          "body": "Wipe seed {seed_fp} from this device? Without a backup, it's gone." }
      ],
      "actions": [
        { "type": "cta", "label": "Keep seed", "kind": "primary", "go": "back" },
        { "type": "cta", "label": "Discard", "kind": "dire", "go": "home",
          "snack": { "type": "success", "label": "Seed {seed_fp} discarded", "sublabel": "Demo: the seed list doesn't change" } }
      ]
    }
  }
}
