{
  "_about": "Redesign clickable prototype: every screen, built from components, and where each tap goes. Ported from seedsigner-touchscreen/prototype/screens.jsx. Schema and rules: context/architecture.md. Keys starting with _ are notes.",

  "start": "home",

  "state": {
    "kb_style": "Default",
    "persistent": true,
    "signer": "73c5da0a",
    "sign_next": "psbt_signing"
  },

  "_flows": "Design Studio only: groups the screens into sections on the canvas, in this order. The device ignores it. A screen in no flow shows under Ungrouped.",
  "flows": [
    { "id": "home", "title": "Home and seeds", "description": "Where every session starts: the seed list, one seed, adding a seed.",
      "screens": ["home", "seeds", "seed", "add_seed"] },
    { "id": "tools", "title": "Tools and settings", "description": "Everything off Home that isn’t a seed.",
      "screens": ["tools", "settings", "kb_style"] },
    { "id": "psbt_review", "title": "Sign PSBT · review", "description": "Pick the signer, then how much leaves this wallet and where it goes.",
      "screens": ["psbt_select_seed", "psbt_overview", "psbt_math", "psbt_send_1", "psbt_send_2", "psbt_change"] },
    { "id": "psbt_sign", "title": "Sign PSBT · sign", "description": "The one irreversible control on the device: a slide, not a tap.",
      "screens": ["psbt_sign", "psbt_signing", "psbt_signing_fail", "psbt_error"] },
    { "id": "psbt_alerts", "title": "Sign PSBT · warnings", "description": "Three severities, one component: warning, dire and error.",
      "screens": ["psbt_warn_script", "psbt_warn_nochange", "psbt_verify_failed"] }
  ],

  "screens": {
    "home": {
      "type": "menu_grid",
      "_note": "Home, 'Scan hero' direction: seeds on top, Scan promoted to the thumb zone at the bottom.",
      "navbar": { "title": "Home", "left": "power" },
      "body": [
        { "type": "group", "children": [
          { "type": "section_head", "label": "Seeds", "right": "All 5", "go": "seeds" },
          { "type": "seed_row", "fp": "73c5da0a", "go": "seed" },
          { "type": "seed_row", "fp": "8a1f0c2b", "go": "seed" },
          { "type": "seed_row", "fp": "d5630e9f", "go": "seed" }
        ]}
      ],
      "actions": [
        { "type": "tile", "icon": "scan", "label": "Scan QR", "primary": true, "h": 80, "go": "psbt_select_seed",
          "_note": "Scanning isn't ported; for now Scan QR opens the PSBT flow as if a PSBT was scanned." },
        { "type": "row", "children": [
          { "type": "tile", "icon": "tools", "label": "Tools", "h": 80, "go": "tools" },
          { "type": "tile", "icon": "settings", "label": "Settings", "h": 80, "go": "settings" }
        ]}
      ]
    },

    "seeds": {
      "type": "menu_list",
      "navbar": { "title": "Seeds", "left": "back" },
      "body": [
