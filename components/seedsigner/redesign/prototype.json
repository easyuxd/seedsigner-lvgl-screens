    "add_seed": {
      "type": "menu_list",
      "navbar": { "title": "Add Seed", "left": "back" },
      "body": [
        { "type": "section_head", "label": "Load an existing seed" },
        { "type": "list_item", "icon": "qrcode", "label": "Scan a SeedQR", "value": "Fastest",
          "snack": { "type": "info", "label": "Scan a SeedQR", "sublabel": "Not ported to LVGL yet" } },
        { "type": "list_item", "icon": "seeds", "label": "Enter seed words",
          "snack": { "type": "info", "label": "Enter seed words", "sublabel": "Not ported to LVGL yet" } },
        { "type": "list_item", "icon": "microsd", "label": "Restore from microSD", "muted": true },
        { "type": "spacer", "h": 6 },
        { "type": "section_head", "label": "Or start fresh" },
        { "type": "list_item", "icon": "plus", "label": "Create a new seed",
          "snack": { "type": "info", "label": "Create a new seed", "sublabel": "Not ported to LVGL yet" } }
      ]
    },

    "tools": {
      "type": "menu_list",
      "navbar": { "title": "Tools", "left": "back" },
      "body": [
        { "type": "list_item", "icon": "derivation", "label": "Address explorer", "muted": true },
        { "type": "list_item", "icon": "check", "label": "Verify address", "muted": true },
        { "type": "list_item", "icon": "seeds", "label": "Seed word calculator", "muted": true },
        { "type": "list_item", "icon": "bitcoin", "label": "Sats / fiat converter", "muted": true },
        { "type": "list_item", "icon": "qrcode", "label": "Create a SeedQR", "muted": true }
      ]
